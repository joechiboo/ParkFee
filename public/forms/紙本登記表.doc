  .head{border:1.5px solid #000;padding:3px 10px;margin:0 0 6px;font-size:11.5px;text-align:center;line-height:1.5}
  h2{font-size:13.5px;margin:6px 0 2px;padding:2px 8px;background:#f0f0f0;border-left:4px solid #444}
  p{margin:3px 0}
  .fld{margin:4px 0}
  .ln{display:inline-block;border-bottom:1px solid #555;min-width:140px;height:1.1em;vertical-align:-3px}
  .ln.sm{min-width:84px}
  .ln.xs{min-width:40px}
